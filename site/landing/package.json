{
  "name": "voicegateway-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "wrangler pages dev out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.functions.json",
    "preview": "wrangler pages dev out",
    "deploy": "pnpm build && wrangler pages deploy out",
    "test": "vitest run",
    "prebuild": "cp ../../collector.sh ../../install.sh public/ && cp -R ../web/public/demo public/",
    "predev": "cp ../../collector.sh ../../install.sh public/ && cp -R ../web/public/demo public/"
  },
  "dependencies": {
    "@fontsource/caveat": "5.3.0",
    "@ncdai/react-wheel-picker": "1.2.3",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-tooltip": "1.4.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.7.2",
    "libphonenumber-js": "1.13.7",
    "motion": "12.42.2",
    "next": "16.2.6",
    "posthog-js": "1.399.0",
    "radix-ui": "1.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "rough-notation": "0.5.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261015.1",
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "@ncdai/react-wheel-picker": "patches/@ncdai__react-wheel-picker.patch"
    }
  }
}
