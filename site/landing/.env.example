# Optional build-time overrides; defaults match the shared mahimai.ca project.
# The publishable PostHog key is public. Never put personal API keys here.
NEXT_PUBLIC_POSTHOG_HOST=https://m.mahimai.ca
# NEXT_PUBLIC_POSTHOG_KEY=your-public-project-key

# Cloudflare CLI account (Pages does not accept account_id in wrangler.jsonc).
CLOUDFLARE_ACCOUNT_ID=c64bf5531f1988a38ec04598b5d7c57d

# No database, stats or email secrets belong in this frontend project.
# VOICEGATEWAY_API is a private Pages service binding configured in wrangler.jsonc.
