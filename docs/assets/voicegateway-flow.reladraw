// VoiceGateway's V1 call view. Conceptual telemetry flow, not audio routing.
// Render with outlined Kalam + Rough.js: npm --prefix docs/assets/flow-source run build
// The sketch is deliberately separate from the quiet console UI.
diagram theme: dark
style quiet text: (color: theme-muted)
style signal fill: theme-primary-subtle border: theme-primary line: theme-primary

node callpath "" fill: none border: none
node callpath.sip "SIP / [quiet]Did it connect?[/quiet]"
node callpath.media "Media server / [quiet]Did audio arrive?[/quiet]" right of callpath.sip
node callpath.agent "Agent / [quiet]Was it healthy?[/quiet]" right of callpath.media
node callpath.turn "One turn" right of callpath.agent style: signal
node callpath.turn.stt "STT"
node callpath.turn.llm "LLM" right of callpath.turn.stt
node callpath.turn.tts "TTS" right of callpath.turn.llm
edge callpath.sip -> callpath.media
edge callpath.media -> callpath.agent
edge callpath.agent -> callpath.turn
edge callpath.turn.stt -> callpath.turn.llm
edge callpath.turn.llm -> callpath.turn.tts

node question "The caller waited. Where did the time go?" (size: large, wrap: 48) shape: none above callpath (gap: normal)
node view "VoiceGateway / One call. One timeline. / [quiet]Transcript · latency · usage · events[/quiet]" below callpath (gap: wide) style: signal
edge callpath -> view "captured telemetry" (color: theme-muted) from: bottom to: top line: (pattern: dashed)
node aside "Observes the call. Never in the audio path." (wrap: 52, size: small, color: theme-muted) shape: none below view (gap: tight)
